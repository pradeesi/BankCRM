# ==============================================================================
# Purpose: Docker and Cloud Build context exclusions for Aurelia Bank CRM.
# Architecture/Context: Prevents virtual environments, Git history, and local
#   SQLite database files from being uploaded during `gcloud run deploy`.
# Dependencies/Side Effects: Consumed by Docker and Google Cloud Build.
# Author: Pradeep Singh
# License: Apache-2.0
# ==============================================================================

.git/
.gitignore
.env
.env.*
**/.env
**/.env.*
venv/
.venv/
**/venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
**/*.db
**/*.db-shm
**/*.db-wal
*.log
*.pid
nohup.out
mcp_server/
