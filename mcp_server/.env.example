# ==============================================================================
# Purpose: Example environment configuration for the Aurelia Bank CRM MCP Server.
# Architecture/Context: Copy this file to `mcp_server/.env` for local execution
#   or supply these variables via Cloud Run / GKE ConfigMaps and Secrets.
# Dependencies/Side Effects: Loaded by `mcp_server/config.py` via `python-dotenv`.
# Author: Pradeep Singh
# License: Apache-2.0
# ==============================================================================

# MCP Server Network & Transport Configuration
MCP_SERVER_NAME=aurelia-bank-crm-mcp
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8081

# SQLite Database Integration (Defaults to shared parent BankCRM database)
DATABASE_PATH=../bank_crm.db
AUTO_SEED_DATABASE=true

# Banking Compliance & Governance Settings
HIGH_VALUE_WIRE_THRESHOLD_USD=25000.00
DEFAULT_AGENT_ACTOR=Aurelia AI Advisory Agent

# Optional API Key Authentication (Leave empty for open local access; set in prod)
MCP_API_KEY=

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
