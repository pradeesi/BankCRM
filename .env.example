# ==============================================================================
# Purpose: Example environment configuration template for Aurelia Bank CRM.
# Architecture/Context: Copy this file to `.env` before local execution or inject
#   these variables via Cloud Run / GKE ConfigMaps and Secrets.
# Dependencies/Side Effects: Read by `config.py` via `python-dotenv`.
# Author: Pradeep Singh
# License: Apache-2.0
# ==============================================================================

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=replace-with-secure-64-char-hex-secret-key-in-production

# Server Binding Configuration
HOST=0.0.0.0
PORT=8080

# SQLite Database Configuration
DATABASE_PATH=bank_crm.db
AUTO_SEED_DATABASE=true

# Institutional & Operational Thresholds
BANK_NAME=Aurelia Private Bank & Trust
HIGH_VALUE_WIRE_THRESHOLD_USD=25000.00
DEFAULT_RM_EMAIL=elena.rostova@aureliabank.com
LOG_LEVEL=INFO
